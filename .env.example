# Football Transfer Value Predictor - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ──────────────────────────────────────────────
# API-Football (RapidAPI) — Optional, not needed for MVP
# Sign up at: https://rapidapi.com/api-sports/api/api-football
# ──────────────────────────────────────────────
RAPIDAPI_KEY=your_rapidapi_key_here
RAPIDAPI_HOST=api-football-v1.p.rapidapi.com

# ──────────────────────────────────────────────
# Database
# ──────────────────────────────────────────────
DATABASE_URL=sqlite:///db/football_transfers.db

# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
LOG_LEVEL=INFO
DATA_DIR=data
MODEL_DIR=models
FOOTBALL_DATA_ORG_API_KEY=your_football_data_org_api_key_here
SPORTMONKS_API_KEY=your_sportmonks_api_token_here
TRANSFERMRKT_API_KEY=your_apify_transfermarkt_token_here
BIGBALLSDATA_API_KEY=your_bigballsdata_sdk_key_here
